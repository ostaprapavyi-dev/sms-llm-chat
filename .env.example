# ---------------------------------------------------------------------------
# Copy to .env and adjust. Every value below is a working default: with no
# .env at all the service runs fully on the mock SMS and mock LLM providers.
# ---------------------------------------------------------------------------

PORT=3000
LOG_LEVEL=INFO
# Exposes GET /debug/outbox (mock provider outbox). Turn off outside local dev.
DEBUG_ENDPOINTS_ENABLED=true

# --- SMS -------------------------------------------------------------------
# mock   -> replies are kept in memory and readable at GET /debug/outbox
# twilio -> replies are sent through the Twilio REST API
SMS_PROVIDER=mock
# api   -> webhook returns 202 immediately, reply is sent as a separate API call
# twiml -> webhook answers synchronously with Twilio Messaging Response XML
SMS_REPLY_MODE=api
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VALIDATE_SIGNATURE=true

# --- LLM -------------------------------------------------------------------
# mock | groq | openai   (groq and openai share one OpenAI-compatible client)
LLM_PROVIDER=mock
# Empty means "use the provider default" (groq: llama-3.3-70b-versatile,
# openai: gpt-4o-mini).
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Storage ---------------------------------------------------------------
# Swap for postgresql+asyncpg://user:pass@host/db to move to PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# How many previous turns of the same phone number are sent to the LLM.
CONVERSATION_HISTORY_LIMIT=10

# --- Admin -----------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password
